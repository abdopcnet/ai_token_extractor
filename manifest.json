{
  "manifest_version": 3,
  "name": "Ai Token Extractor",
  "version": "1.1.0",
  "description": "Extract bearer tokens from web sessions for AI providers",
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://www.kimi.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://www.kimi.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
